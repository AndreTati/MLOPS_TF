# Copiar este archivo como .env y completar valores locales seguros.
# No utilizar credenciales personales ni reutilizar contraseñas reales.

# Airflow
AIRFLOW_UID=50000
AIRFLOW_GID=0
AIRFLOW_PROJ_DIR=./airflow
AIRFLOW_PORT=8080
_AIRFLOW_WWW_USER_USERNAME=airflow_local
_AIRFLOW_WWW_USER_PASSWORD=CAMBIAR_EN_ARCHIVO_ENV_LOCAL
AIRFLOW_API_JWT_SECRET=GENERAR_SECRETO_LOCAL_ALEATORIO

# PostgreSQL
PG_USER=airflow_local
PG_PASSWORD=CAMBIAR_EN_ARCHIVO_ENV_LOCAL
PG_DATABASE=airflow
PG_PORT=5432

# MinIO
MINIO_ACCESS_KEY=CAMBIAR_EN_ARCHIVO_ENV_LOCAL
MINIO_SECRET_ACCESS_KEY=CAMBIAR_EN_ARCHIVO_ENV_LOCAL
MINIO_PORT=9000
MINIO_PORT_UI=9001
BUCKET_NAME=data
